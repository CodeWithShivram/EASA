# Docker Compose settings for the local PostgreSQL container (compose.yaml).
# Copy to .env (git-ignored) in the repository root and set a random password.
# Development only; never reuse a real password here.
EASA_POSTGRES_PASSWORD=change-me-to-a-random-value

# Host port (bound to 127.0.0.1). Default 5433, so a local PostgreSQL on 5432 is untouched.
# EASA_POSTGRES_PORT=5433