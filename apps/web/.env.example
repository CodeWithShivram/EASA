# EASA web configuration. Copy to .env.local (git-ignored) to override.
# Read only by the web app's server (route handlers under /bff and the proxy);
# nothing here is sent to the browser. The browser talks to this app, and this
# app talks to the API (ADR-034).

# Base URL of the EASA API (http or https, no path). Defaults to http://localhost:8000.
EASA_API_URL=http://localhost:8000
