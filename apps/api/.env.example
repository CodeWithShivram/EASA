# EASA API configuration. Copy to .env (git-ignored) and adjust as needed.
# Unknown EASA_ keys in .env cause startup to fail.
# Never commit real credentials.

# development | test | production  (production disables /docs and /openapi.json)
EASA_ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL
EASA_LOG_LEVEL=INFO

# Allowed drivers: sqlite, sqlite+pysqlite, postgresql+psycopg.
# Defaults to an SQLite file at apps/api/var/easa.db (git-ignored) when unset.
# EASA_DATABASE_URL=sqlite:///./var/easa.db

# JSON list of explicit origins; wildcards are rejected.
EASA_CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Directory for uploaded file contents (content-addressed, never served directly).
# Defaults to apps/api/var/uploads (git-ignored) when unset.
# EASA_STORAGE_DIR=./var/uploads

# Largest accepted uploaded file in bytes (1 to 104857600). Default 10 MiB.
# EASA_MAX_UPLOAD_BYTES=10485760

# PDFs with more pages fail processing with too_many_pages (1 to 5000). Default 500.
# EASA_MAX_PDF_PAGES=500

# Chunking: "structured" (page/section-aware) or "fixed" (overlapping windows).
# Overlap must be less than half of the maximum size.
# EASA_CHUNK_STRATEGY=structured
# EASA_CHUNK_MAX_CHARS=1200
# EASA_CHUNK_OVERLAP_CHARS=150

# Development-only identity for document endpoints (ADR-014). Synthetic UUIDs.
# Document endpoints are not mounted when EASA_ENVIRONMENT=production.
# EASA_DEV_TENANT_ID=00000000-0000-4000-8000-000000000001
# EASA_DEV_USER_ID=00000000-0000-4000-8000-000000000002
