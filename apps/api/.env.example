# EASA API configuration. Copy to .env (git-ignored) and adjust as needed.
# Unknown EASA_ keys in .env cause startup to fail.
# Never commit real credentials.

# development | test | production  (production disables /docs and /openapi.json)
EASA_ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL
EASA_LOG_LEVEL=INFO

# Allowed drivers: sqlite, sqlite+pysqlite, postgresql+psycopg.
# Defaults to an SQLite file at apps/api/var/easa.db (git-ignored) when unset.
# EASA_DATABASE_URL=sqlite:///./var/easa.db
# PostgreSQL + pgvector from the repository's compose.yaml (see docs/DEVELOPMENT_GUIDE.md):
# EASA_DATABASE_URL=postgresql+psycopg://easa:<password>@127.0.0.1:5433/easa

# JSON list of explicit origins; wildcards are rejected.
EASA_CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Directory for uploaded file contents (content-addressed, never served directly).
# Defaults to apps/api/var/uploads (git-ignored) when unset.
# EASA_STORAGE_DIR=./var/uploads

# Largest accepted uploaded file in bytes (1 to 104857600). Default 10 MiB.
# EASA_MAX_UPLOAD_BYTES=10485760

# PDFs with more pages fail processing with too_many_pages (1 to 5000). Default 500.
# EASA_MAX_PDF_PAGES=500

# Chunking: "structured" (page/section-aware) or "fixed" (overlapping windows).
# Overlap must be less than half of the maximum size.
# EASA_CHUNK_STRATEGY=structured
# EASA_CHUNK_MAX_CHARS=1200
# EASA_CHUNK_OVERLAP_CHARS=150

# Sign-in sessions (ADR-031). Users are created with
#   uv run python -m app.cli create-user --tenant NAME --username NAME --role employee
# EASA_SESSION_IDLE_MINUTES=480
# EASA_SESSION_LIFETIME_HOURS=24
# scrypt cost; production requires at least 32768.
# EASA_PASSWORD_HASH_N=32768

# Rate limits per minute (ADR-035), kept in this process; 0 turns a limit off.
# Sign-in attempts per client address, model calls per signed-in user.
# EASA_RATE_LIMIT_LOGIN_PER_MINUTE=20
# EASA_RATE_LIMIT_MODEL_PER_MINUTE=10
# Proxies (IP addresses) whose X-Forwarded-For is believed. Only list a proxy
# that overwrites the header. Run uvicorn with --no-proxy-headers.
# EASA_TRUSTED_PROXIES=[]

# Embeddings: "onnx" (pinned local model; run
#   uv run python -m app.cli download-embedding-model
# first) or "hashing" (deterministic, NOT semantic; for tests and offline work).
# EASA_EMBEDDING_PROVIDER=onnx
# EASA_EMBEDDING_MODEL_DIR=./var/models
# EASA_EMBEDDING_BATCH_SIZE=32

# Answer generation (Phase 4): "none" (default, disabled), "fake" (deterministic
# test double; rejected in production), "llamacpp" (the llama.cpp server from
# compose.yaml, profile "llm") or "ollama" (a local Ollama server).
# For the local model: run download-chat-model, start the llm service, then
#   EASA_MODEL_PROVIDER=llamacpp
#   EASA_MODEL_NAME=qwen2.5-1.5b-instruct-q4_k_m
# EASA_MODEL_PROVIDER=none
# EASA_LLAMACPP_BASE_URL=http://127.0.0.1:8082
# EASA_OLLAMA_BASE_URL=http://127.0.0.1:11434
# EASA_CHAT_MODEL_DIR=./var/models/llm
# EASA_MODEL_NAME=
# EASA_MODEL_TIMEOUT_SECONDS=120
# EASA_MODEL_MAX_OUTPUT_TOKENS=512
# EASA_MODEL_TEMPERATURE=0.1
